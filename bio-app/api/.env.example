# 必填：MySQL/MariaDB 数据库连接
DATABASE_URL="mysql://app_user:replace_me@127.0.0.1:3306/bio_app"

# API 服务
PORT=9092
TOKEN_TTL_MS=604800000

# MapProcess 图谱解析服务：http、cli 或 disabled
DATASET_PARSER_MODE=http
DATASET_PARSER_URL=http://127.0.0.1:8000
DATASET_PARSER_TIMEOUT_MS=300000
# DATASET_PARSER_COMMAND=

# 持久化数据与临时文件。生产环境建议指向独立挂载卷。
BIOAPP_DATA_DIR=C:/bio-app-data
BIOAPP_TEMP_DIR=C:/bio-app-temp
# 以下配置可覆盖统一目录中的具体子目录
# USER_FILE_STORAGE_DIR=C:/bio-app-data/user-files
# AVATAR_STORAGE_DIR=C:/bio-app-data/avatars
# FEEDBACK_STORAGE_DIR=C:/bio-app-data/feedback
# DATASET_UPLOAD_TMP_DIR=C:/bio-app-temp/uploads
DATASET_UPLOAD_MAX_BYTES=52428800
# Maximum map files per request; split larger uploads into batches.
DATASET_UPLOAD_MAX_FILES=50
USER_FILE_MAX_BYTES=52428800

# T-Pro 服务（使用 T-Pro 时必填）
TPRO_API_URL=http://127.0.0.1:8004/
TPRO_REQUEST_TIMEOUT_MS=600000
TPRO_MAX_CONCURRENCY=2

# SMTP（找回密码和邮箱验证码需要；不使用邮件功能时可留空）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_auth_code
SMTP_FROM_NAME=Bio App
